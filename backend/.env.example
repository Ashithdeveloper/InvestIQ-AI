# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas / Local Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/investiq_db

# JWT Configuration
JWT_SECRET=investiq_super_secret_jwt_key_production_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*

# Financial Profile Age Constraints
MIN_INVEST_AGE=18
MAX_INVEST_AGE=100

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=investiq_company_financials

# Ollama Cloud & AI Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:4b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
